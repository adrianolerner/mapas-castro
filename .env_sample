# ==============================================================================
# CONFIGURAÇÃO - MAPA CULTURAL DE CASTRO (PREFEITURA MUNICIPAL DE CASTRO - PR)
# ==============================================================================

# URL base da aplicação (em produção, ex: https://mapacultural.castro.pr.gov.br/)
BASE_URL=http://localhost/

# Identidade da Instalação
SITE_NAME="Mapa Cultural de Castro"
SITE_DESCRIPTION="O Mapa Cultural de Castro é a plataforma colaborativa da Prefeitura Municipal de Castro (PR) que reúne informações sobre agentes, espaços, eventos, projetos culturais e oportunidades."
LOGO_IMAGE=img/logo.png
LOGO_HIDELABEL=false
LOGO_TITLE="Mapa Cultural"
LOGO_SUBTITLE="Castro - PR"
HOME_HEADER_TITLE="Boas vindas ao Mapa Cultural de Castro - PR!"
HOME_HEADER_DESCRIPTION="A PLATAFORMA DE MAPAS CULTURAIS DE CASTRO - PR é um instrumento para a promoção da política cultural de Castro - PR, é uma plataforma colaborativa de gestão pública, permitindo aos gestores, agentes culturais e a todos os cidadãos conhecer, compartilhar e participar da produção e ações que integram a política cultural de Castro - PR. Participe, Navegue, se informe, contribua e interaja com a gente!"

# Ambiente e Logs
APP_MODE=production
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=WARNING
LOG_ENABLED=true

# Mapa e Geolocalização (Coordenadas de Castro - PR)
MAPS_LATITUDE=-24.7911
MAPS_LONGITUDE=-50.0119
MAPS_ZOOM_DEFAULT=13
MAPS_ZOOM_MIN=9
MAPS_ZOOM_MAX=18

# Token de busca de CEP (opcional)
CEP_TOKEN=

# Configuração de E-mail (SMTP)
# Exemplo: smtp://usuario:senha@smtp.castro.pr.gov.br:587
MAILER_TRANSPORT=
MAILER_FROM=cultura@castro.pr.gov.br

# Usado para redirecionar todos os e-mails da plataforma para um email fixo em homologação
MAILER_ALWAYSTO=

# Banco de Dados (PostgreSQL + PostGIS 16)
DB_HOST=db
DB_NAME=mapas
DB_USER=mapas
DB_PASS=mapas
DB_VERSION=16

# Segurança e Autenticação (MultipleLocalAuth)
# IMPORTANTE: Gere uma string aleatória longa para AUTH_SALT em produção!
AUTH_SALT=castro_pr_mapas_culturais_change_me_in_production_2026
AUTH_ENABLE_CPF=true
AUTH_CONFIRM_EMAIL=false

# As chaves reCAPTCHA abaixo são de teste do Google; substitua pelas chaves reais do domínio em produção
GOOGLE_RECAPTCHA_SITEKEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
GOOGLE_RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Intervalos de processamento em background (em segundos)
PENDING_PCACHE_RECREATION_INTERVAL=60
JOBS_INTERVAL=15
