# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force LF on scripts, configs, and Docker files even on Windows
*.sh text eol=lf
*.php text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf
.env* text eol=lf

# PowerShell scripts
*.ps1 text eol=crlf
